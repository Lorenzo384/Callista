<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.callista.view.MainFrame">
  <grid id="06f01" binding="rootPanel" layout-manager="GridLayoutManager" row-count="8" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="8">
    <margin top="10" left="10" bottom="10" right="10"/>
    <constraints>
      <xy x="20" y="20" width="420" height="760"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="06f02" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="06f03" class="javax.swing.JLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Operación:"/>
            </properties>
          </component>
          <component id="06f04" class="javax.swing.JComboBox" binding="operationComboBox">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
          </component>
        </children>
      </grid>
      <nested-form id="06f05" form-file="com/callista/view/components/InputPanel.form" binding="inputPanel">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
      </nested-form>
      <grid id="06f06" binding="parametersPanel" layout-manager="GridLayoutManager" row-count="7" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="4" left="8" bottom="8" right="8"/>
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none" title="Parámetros"/>
        <children>
          <nested-form id="06f07" form-file="com/callista/view/panels/EvaluationPanel.form" binding="evaluationPanel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
          </nested-form>
          <nested-form id="06f08" form-file="com/callista/view/panels/DerivativePanel.form" binding="derivativePanel">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
          </nested-form>
          <nested-form id="06f09" form-file="com/callista/view/panels/IntegralPanel.form" binding="integralPanel">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
          </nested-form>
          <nested-form id="06f0a" form-file="com/callista/view/panels/AreaPanel.form" binding="areaPanel">
            <constraints>
              <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
          </nested-form>
          <nested-form id="06f0b" form-file="com/callista/view/panels/RevolutionPanel.form" binding="revolutionPanel">
            <constraints>
              <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
          </nested-form>
          <component id="06f0c" class="javax.swing.JLabel" binding="noParametersLabel">
            <constraints>
              <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Sin parámetros: se calcula ∫ f(x) dx + C."/>
            </properties>
          </component>
          <component id="06f0d" class="javax.swing.JLabel" binding="unavailableLabel">
            <constraints>
              <grid row="6" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Esta operación estará disponible próximamente."/>
            </properties>
          </component>
        </children>
      </grid>
      <nested-form id="06f0e" form-file="com/callista/view/components/KeypadPanel.form" binding="keypadPanel">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
      </nested-form>
      <nested-form id="06f0f" form-file="com/callista/view/components/ActionPanel.form" binding="actionPanel">
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
      </nested-form>
      <nested-form id="06f10" form-file="com/callista/view/components/ResultPanel.form" binding="resultPanel">
        <constraints>
          <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
      </nested-form>
      <tabbedpane id="06f11" binding="bottomTabs">
        <constraints>
          <grid row="6" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <preferred-size width="200" height="160"/>
          </grid>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="06f12" class="com.callista.view.components.StepsPanel" binding="stepsPanel">
            <constraints>
              <tabbedpane title="Procedimiento"/>
            </constraints>
            <properties/>
          </component>
          <component id="06f13" class="com.callista.view.components.GraphPanel" binding="graphPanel">
            <constraints>
              <tabbedpane title="Gráfica"/>
            </constraints>
            <properties/>
          </component>
          <component id="06f14" class="com.callista.view.components.SolidPanel" binding="solidPanel">
            <constraints>
              <tabbedpane title="Sólido 3D"/>
            </constraints>
            <properties/>
          </component>
        </children>
      </tabbedpane>
      <component id="06f15" class="javax.swing.JLabel" binding="statusLabel">
        <constraints>
          <grid row="7" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Radianes · Variable: x · Listo"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
