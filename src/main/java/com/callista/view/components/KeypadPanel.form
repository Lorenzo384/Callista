<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.callista.view.components.KeypadPanel">
  <grid id="02b01" binding="rootPanel" layout-manager="GridLayoutManager" row-count="3" column-count="5" same-size-horizontally="true" same-size-vertically="false" hgap="-1" vgap="-1">
