<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.callista.view.panels.EvaluationPanel">
  <grid id="05e01" binding="rootPanel" layout-manager="GridLayoutManager" row-count="2" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="420" height="60"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="05e02" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="x ="/>
        </properties>
      </component>
      <component id="05e03" class="javax.swing.JTextField" binding="valueField">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="150" height="-1"/>
          </grid>
        </constraints>
        <properties>
          <text value="0"/>
          <toolTipText value="Punto donde se evalúa la función"/>
        </properties>
      </component>
      <component id="05e04" class="javax.swing.JTextArea" binding="hintArea">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false">
            <minimum-size width="50" height="34"/>
            <preferred-size width="150" height="34"/>
          </grid>
        </constraints>
        <properties>
          <editable value="false"/>
          <focusable value="false"/>
          <lineWrap value="true"/>
          <opaque value="false"/>
          <text value="Número o expresión sin x: 2, -1.5, pi/2"/>
          <wrapStyleWord value="true"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
